{
  "1": {"class_type": "LoadImage", "_meta": {"title": "Case de depart"},
        "inputs": {"image": "h3orbital/qbuilder/start.png"}},
  "2": {"class_type": "ImageScaleToTotalPixels", "_meta": {"title": "Taille de generation (ratio de la case, pas de 32)"},
        "inputs": {"image": ["1", 0], "upscale_method": "lanczos", "megapixels": 0.58, "resolution_steps": 32}},
  "4": {"class_type": "UNETLoader", "_meta": {"title": "MiniMax H3 FL2VA pruned"},
        "inputs": {"unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors", "weight_dtype": "default"}},
  "5": {"class_type": "LoraLoaderModelOnly", "_meta": {"title": "LoRA 360 Orbit (1.0 orbit / 0.0 path)"},
        "inputs": {"model": ["4", 0], "lora_name": "minimax_h3_flf2v_lora_v1.safetensors", "strength_model": 1.0}},
  "6": {"class_type": "CLIPLoader", "_meta": {"title": "Qwen3-VL"},
        "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default"}},
  "7": {"class_type": "VAELoader", "_meta": {"title": "VAE video"},
        "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}},
  "8": {"class_type": "H3OrbitalConditioning", "_meta": {"title": "H3 Orbital Conditioning"},
        "inputs": {"clip": ["6", 0], "vae": ["7", 0], "start_image": ["2", 0], "mode": "orbit", "prompt": "",
                   "length": 73, "ref_image_size": "match", "mirror": false,
                   "character_1": ["21", 0], "character_2": ["22", 0], "character_3": ["23", 0], "character_4": ["24", 0],
                   "set_1": ["31", 0], "set_2": ["32", 0], "set_3": ["33", 0], "set_4": ["34", 0],
                   "plan": ["40", 0]}},
  "9": {"class_type": "RandomNoise", "_meta": {"title": "Seed"}, "inputs": {"noise_seed": 904231}},
  "10": {"class_type": "KSamplerSelect", "_meta": {"title": "Sampler"}, "inputs": {"sampler_name": "res_multistep"}},
  "11": {"class_type": "BasicScheduler", "_meta": {"title": "Steps"},
         "inputs": {"model": ["5", 0], "scheduler": "simple", "steps": 28, "denoise": 1.0}},
  "12": {"class_type": "BasicGuider", "_meta": {"title": "Guider (pas de CFG)"},
         "inputs": {"model": ["5", 0], "conditioning": ["8", 0]}},
  "13": {"class_type": "SamplerCustomAdvanced", "_meta": {"title": "Echantillonnage"},
         "inputs": {"noise": ["9", 0], "guider": ["12", 0], "sampler": ["10", 0], "sigmas": ["11", 0],
                    "latent_image": ["8", 1]}},
  "14": {"class_type": "VAEDecode", "_meta": {"title": "Decodage"}, "inputs": {"samples": ["13", 0], "vae": ["7", 0]}},
  "15": {"class_type": "CreateVideo", "_meta": {"title": "Video 24 i/s sans audio"},
         "inputs": {"images": ["14", 0], "fps": 24, "bit_depth": 8}},
  "16": {"class_type": "SaveVideo", "_meta": {"title": "Sortie"},
         "inputs": {"video": ["15", 0], "filename_prefix": "H3-Orbital/scene", "format": "auto", "codec": "auto"}},
  "21": {"class_type": "LoadImage", "_meta": {"title": "Perso 1"}, "inputs": {"image": "h3orbital/qbuilder/character_1.png"}},
  "22": {"class_type": "LoadImage", "_meta": {"title": "Perso 2"}, "inputs": {"image": "h3orbital/qbuilder/character_2.png"}},
  "23": {"class_type": "LoadImage", "_meta": {"title": "Perso 3"}, "inputs": {"image": "h3orbital/qbuilder/character_3.png"}},
  "24": {"class_type": "LoadImage", "_meta": {"title": "Perso 4"}, "inputs": {"image": "h3orbital/qbuilder/character_4.png"}},
  "31": {"class_type": "LoadImage", "_meta": {"title": "Decor 1"}, "inputs": {"image": "h3orbital/qbuilder/set_1.png"}},
  "32": {"class_type": "LoadImage", "_meta": {"title": "Decor 2"}, "inputs": {"image": "h3orbital/qbuilder/set_2.png"}},
  "33": {"class_type": "LoadImage", "_meta": {"title": "Decor 3"}, "inputs": {"image": "h3orbital/qbuilder/set_3.png"}},
  "34": {"class_type": "LoadImage", "_meta": {"title": "Decor 4"}, "inputs": {"image": "h3orbital/qbuilder/set_4.png"}},
  "40": {"class_type": "LoadImage", "_meta": {"title": "Plan vu de dessus (Qwen seulement)"},
         "inputs": {"image": "h3orbital/qbuilder/plan.png"}}
}
